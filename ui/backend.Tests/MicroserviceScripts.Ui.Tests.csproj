<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\backend\MicroserviceScripts.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compose projects captured with Fixtures/capture.py: no containers needed. -->
    <!-- Their source files are data for the route finder, not part of this build. -->
    <Compile Remove="Fixtures\**" />
    <None Include="Fixtures\**" Exclude="Fixtures\capture.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>