# Copy this file to observability/.env and fill it in:
#   cp observability/.env.example observability/.env
#
# observability/.env is git-ignored, so your key never lands in the repo.
# Relative paths below are read from the observability/ directory.

# --- Required ----------------------------------------------------------------

# Distributed tracing backend. Get a key from https://ui.honeycomb.io/ ->
# Environment settings -> API Keys. The free tier is plenty.
HONEYCOMB_API_KEY=your_honeycomb_ingest_key_here

# The docker network your app's containers run on. The stack joins it so it
# can scrape your services and they can reach the collector by name.
# Find it with:  docker network ls
# A compose network without an explicit `name:` is called <project>_<network>,
# e.g. myapp_default.
APP_NETWORK=myapp_default

# --- Optional ----------------------------------------------------------------

# Folder of extra Prometheus scrape jobs for this system (its gateway etc.).
# Defaults to the empty prometheus/scrape.d.
# SCRAPE_DIR=../systems/<your-system>/prometheus

# Which listening ports Beyla instruments, and the namespace it reports under.
# BEYLA_OPEN_PORT=8000-8090
# BEYLA_SERVICE_NAMESPACE=myapp
